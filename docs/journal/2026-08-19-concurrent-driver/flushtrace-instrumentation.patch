diff --git a/src/common/src/lib.rs b/src/common/src/lib.rs
index 1bf56a9..8a96f4f 100644
--- a/src/common/src/lib.rs
+++ b/src/common/src/lib.rs
@@ -8,3 +8,45 @@ pub mod metrics;
 pub mod signal;
 pub mod ssl;
 pub mod traits;
+
+// TEMPORARY INSTRUMENTATION (uncommitted): flush_all timing trace.
+// Recorded with plain atomic stores so the worker path takes no lock and makes
+// no syscall -- an eprintln! here perturbs the very interleaving we measure.
+pub mod flushtrace {
+    use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+
+    pub const MAX: usize = 64;
+    pub static SLOT: AtomicUsize = AtomicUsize::new(0);
+    pub static RECV: [AtomicU64; MAX] = [const { AtomicU64::new(0) }; MAX];
+    pub static DONE: [AtomicU64; MAX] = [const { AtomicU64::new(0) }; MAX];
+    pub static BCAST: AtomicU64 = AtomicU64::new(0);
+
+    pub fn now() -> u64 {
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos() as u64
+    }
+
+    pub fn record(recv: u64, done: u64) {
+        let i = SLOT.fetch_add(1, Ordering::Relaxed);
+        if i < MAX {
+            RECV[i].store(recv, Ordering::Relaxed);
+            DONE[i].store(done, Ordering::Relaxed);
+        }
+    }
+
+    pub fn dump() -> String {
+        let n = SLOT.load(Ordering::Relaxed).min(MAX);
+        let b = BCAST.load(Ordering::Relaxed);
+        let mut s = format!("FLUSHTRACE bcast={b} workers={n}");
+        for i in 0..n {
+            s.push_str(&format!(
+                " [{i}] recv_us={:.1} done_us={:.1}",
+                (RECV[i].load(Ordering::Relaxed).wrapping_sub(b)) as f64 / 1000.0,
+                (DONE[i].load(Ordering::Relaxed).wrapping_sub(b)) as f64 / 1000.0
+            ));
+        }
+        s
+    }
+}
