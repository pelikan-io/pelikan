+/// Owns a worker wake read descriptor until the backend driver takes it.
+struct WorkerReadFd {
+    fd: RawFd,
+    #[cfg(not(has_io_uring))]
+    owned: bool,
+}
+
+impl WorkerReadFd {
+    fn new(fd: RawFd) -> Self {
+        Self {
+            fd,
+            #[cfg(not(has_io_uring))]
+            owned: true,
+        }
+    }
+
+    fn as_raw_fd(&self) -> RawFd {
+        self.fd
+    }
+
+    fn transfer_to_driver(&mut self) {
+        #[cfg(not(has_io_uring))]
+        {
+            self.owned = false;
+        }
+    }
+}
+
+impl Drop for WorkerReadFd {
+    fn drop(&mut self) {
+        #[cfg(not(has_io_uring))]
+        if self.owned {
+            unsafe {
+                libc::close(self.fd);
+            }
+        }
+    }
+}
