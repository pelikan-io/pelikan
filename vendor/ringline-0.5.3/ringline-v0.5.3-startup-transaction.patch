+        for _ in 0..required {
+            let slot = self.free_list.pop().expect("capacity was checked");
+            self.in_use[slot as usize] = true;
+            self.slot_offset[slot as usize] = 0;
+            self.slot_remaining[slot as usize] = 0;
+            self.slot_end_of_send[slot as usize] = true;
+            slots.push(slot);
+        }
+        Some(slots)
+    }
