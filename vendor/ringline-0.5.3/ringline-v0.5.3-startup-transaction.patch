+    pub fn reserve_slots(&mut self, required: usize) -> Option<Vec<u16>> {
+        if required > self.free_list.len() {
+            crate::metrics::POOL.increment(crate::metrics::pool::SEND_EXHAUSTED);
+            return None;
+        }
